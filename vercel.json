{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/woynu-ai.ts": { "maxDuration": 120 }
  },
  "rewrites": [{ "source": "/((?!api/|assets/|photos/|.*\\..*).*)", "destination": "/index.html" }]
}
