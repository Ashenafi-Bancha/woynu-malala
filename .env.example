# Woynu AI — copy to .env for local development (never commit .env).
# On Vercel, add these under Project → Settings → Environment Variables.

# Image provider: "openai" (default) or "preview" (labelled test sketch, no AI, no key needed)
IMAGE_GENERATION_PROVIDER=openai

# Server-side only. Never prefix with VITE_ — that would expose it in the browser.
IMAGE_GENERATION_API_KEY=

# Optional
IMAGE_GENERATION_MODEL=gpt-image-1
# low | medium | high  (higher costs more and takes longer)
IMAGE_GENERATION_QUALITY=medium
# Extra origins allowed to call /api/woynu-ai, comma-separated (same-origin is always allowed)
WOYNU_AI_ALLOWED_ORIGINS=
